# =============================================================================
# TokenPlan — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values before running.
#   cp .env.example .env
# =============================================================================

# ---- Database (MySQL) ----
# When running via docker-compose, host is the service name `db`.
# For local `next dev` against a local MySQL, use 127.0.0.1.
DATABASE_URL="mysql://tokenplan:tokenplan@db:3306/tokenplan"

# Individual vars consumed by the mysql container in docker-compose.
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=tokenplan
MYSQL_USER=tokenplan
MYSQL_PASSWORD=tokenplan

# ---- NextAuth ----
# Generate a strong secret, e.g.  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:8914"

# ---- Default admin (created by prisma seed) ----
ADMIN_EMAIL="admin@tokenplan.local"
ADMIN_PASSWORD="admin12345"

# ---- Seed provider API keys (used only to seed the DB the first time) ----
# After first run these live in the ProviderConfig table and can be edited in
# the admin UI. Leave blank to skip seeding a provider's key here.
SEED_DEEPSEEK_API_KEY=""
SEED_DEEPSEEK_BASE_URL="https://api.deepseek.com/openai/v1"

SEED_MINIMAX_API_KEY=""
SEED_MINIMAX_BASE_URL="https://api.minimax.chat/openai/v1"

SEED_LONGCAT_API_KEY=""
SEED_LONGCAT_BASE_URL="https://api.longcat.chat/openai/v1"

SEED_OPENAI_API_KEY=""
SEED_OPENAI_BASE_URL="https://api.openai.com/v1"

SEED_ANTHROPIC_API_KEY=""
SEED_ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
